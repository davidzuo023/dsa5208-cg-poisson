#!/bin/bash
# The job that produced results/vanda (36 cores of one Vanda node, free queue).
#PBS -N cg_vanda36
#PBS -q auto_free
#PBS -j oe
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=36:mpiprocs=36:ompthreads=1:mem=100gb

cd "$PBS_O_WORKDIR"
module load gcc/13.1.0 openmpi/gcc/64/4.1.8
export OMPI_MCA_btl_vader_single_copy_mechanism=none
export OMPI_MCA_mca_base_component_show_load_errors=0

export BIN=bin_vanda36
make -B BIN=$BIN OPT="-O3 -march=native" all

OUT=results/vanda36/validation bash scripts/validate.sh quick || echo "validation FAILED"

MACHINE=vanda36 NS=512 NW=192 ITERS=50 REPS=3 VARIANT_PMIN=4 bash scripts/run_suite.sh
